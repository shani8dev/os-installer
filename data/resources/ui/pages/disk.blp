using Gtk 4.0;
using Adw 1;

template $DiskPage : Stack {
  hexpand: true;
  vhomogeneous: false;
  transition-type: crossfade;

  StackPage {
    name: "disks";
    child: Box {
      orientation: vertical;
      spacing: 12;

      Label min_size_label {
        halign: start;
        wrap: true;
        styles ["dimmed"]
      }

      Box existing_box {
        orientation: vertical;
        spacing: 6;
        visible: false;

        Label existing_label {
          wrap: true;
          xalign: 0;
          styles ["heading"]
        }

        Adw.ComboRow existing_mode {
          title: _("What should the installer do?");
        }

        $ContinueButton existing_continue {
          clicked => $existing_continue();
          receives-default: true;
          visible: false;
        }
      }

      Box {
        orientation: vertical;
        spacing: 12;

        ListBox disk_list {
          selection-mode: none;
          receives-default: true;
          valign: start;
          row-activated => $disk_selected();
          styles ["boxed-list"]
        }

        Button disks_button {
          action-name: "external.manage-disks";
          /* Translators: Button label to open disk management tool. */
          label: _("_Manage Disks");
          focusable: true;
          halign: center;
          valign: end;
          use-underline: true;
          styles ["pill"]
        }
      }
    };
  }

  StackPage {
    name: "no-disks";
    child: Adw.StatusPage no_disks_page {
      /* Translators: Title of a hint page */
      title: _("No Disks available");
      /* Translators: Body of a hint page */
      description: _("Connect a disk and reload this page.");
      valign: start;
      child: Button reload_button {
        action-name: "win.reload-page";
        /* Translators: On button. */
        label: _("_Reload");
        focusable: true;
        receives-default: true;
        halign: center;
        use-underline: true;
        styles ["pill"]
      };
    };
  }
}
