using Gtk 4.0;
using Adw 1;

template $TpmPage : Box {
  orientation: vertical;
  spacing: 12;

  ListBox {
    selection-mode: none;
    styles ["boxed-list"]

    Adw.ActionRow tpm_row {
      /* Translators: TPM state shown on the TPM page. */
      title: _("TPM 2.0");
      activatable: false;
    }

    Adw.SwitchRow switch_row {
      activatable: true;
      /* Translators: Used with option to let the TPM unlock the encrypted disk
         automatically. */
      title: _("Unlock the disk with the TPM");
      /* Translators: Shown under the TPM switch. */
      subtitle: _("The disk unlocks automatically on this machine. The encryption PIN stays as a fallback.");
      notify::active => $switch_row_clicked();
    }
  }

  Adw.Banner hint_banner {
    title: _("The installer enrolls the TPM during installation. If the firmware or Secure Boot state changes later, run: sudo gen-efi.sh enroll-tpm2");
    revealed: true;
  }

  $ContinueButton continue_button {
    action-name: "win.advance";
    receives-default: true;
  }
}