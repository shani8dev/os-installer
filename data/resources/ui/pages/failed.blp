using Gtk 4.0;
using Adw 1;

template $FailedPage : Box {
  orientation: vertical;
  spacing: 12;

  Adw.StatusPage failure_page {
    /* Translators: Title of installation failure page.*/
    title: _("Error During Installation");
    /* Translators: Installation failure description. Brackets will be replaced by the distribution name. */
    description: _("Details on the error that occurred can be found in the installation logs. Please report this error to {}.");
    child: $TerminalButton {};
  }

  Box log_box {
    orientation: vertical;
    spacing: 6;

    Label log_label {
      selectable: true;
      wrap: true;
      xalign: 0;
      styles ["dimmed"]
    }

    Button copy_log_button {
      label: _("Copy log");
      halign: start;
      clicked => $copy_log();
      styles ["pill"]
    }
  }

  Button {
    action-name: "external.error-search";
    focusable: true;
    receives-default: true;
    halign: center;
    styles ["pill"]

    Label search_button {
      /* Translators: Shown if installation fails. */
      label: _("Search for Help on the Internet");
      use-markup: true;
      wrap: true;
    }
  }
}
