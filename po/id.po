#: data/com.github.p3732.OS-Installer.desktop.in
msgid "OS-Installer"
msgstr "OS-Installer"

#: data/com.github.p3732.OS-Installer.desktop.in
#: data/com.github.p3732.OS-Installer.metainfo.xml.in
msgid "Install an Operating System"
msgstr "Instal Sistem Operasi"

#. Translators: Label on button to copy terminal output.
#: data/resources/ui/terminal_dialog.blp
msgid "_Copy"
msgstr "Salin"

#. Translators: Followed by a disk or partition name
#: data/resources/ui/pages/confirm.blp
msgid "This will delete all data on"
msgstr "Ini akan menghapus semua data di"

#. Translators: On button, brackets will be replaced with desktop name.
#: data/resources/ui/pages/desktop.blp
msgid "_Use {}"
msgstr "Gunakan {}"

#. Translators: Button label to open disk management tool.
#: data/resources/ui/pages/disk.blp
msgid "_Manage Disks"
msgstr "Kelola Disk"

#. Translators: Title of a hint page
#: data/resources/ui/pages/disk.blp
msgid "No Disks avaliable"
msgstr "Tidak Ada Disk Tersedia"

#. Translators: Body of a hint page
#: data/resources/ui/pages/disk.blp
msgid "Connect a disk and reload this page."
msgstr "Hubungkan disk dan muat ulang halaman ini."

#. Translators: On button.
#: data/resources/ui/pages/disk.blp
msgid "_Reload"
msgstr "Muat Ulang"

#. Translators: Button label to restart system directly after successful installation. Underscore can not be for same letter as 'Restart Later'.
#: data/resources/ui/pages/done.blp
msgid "_Restart System"
msgstr "Mulai Ulang Sistem"

#. Translators: Button label to delay restart after successful installation. Underscore can not be for same letter as 'Restart System'.
#: data/resources/ui/pages/done.blp
msgid "Restart _Later"
msgstr "Mulai Ulang Nanti"

#. Translators: Used with option to enable disk encryption
#: data/resources/ui/pages/encrypt.blp
msgid "Encrypt Files"
msgstr "Enkripsi File"

#. Translators: Disk encryption pin confirmation entry field
#: data/resources/ui/pages/encrypt.blp
msgid "Encryption PIN"
msgstr "PIN Enkripsi"

#. Translators: Disk encryption pin confirmation entry field
#: data/resources/ui/pages/encrypt.blp
msgid "Confirm PIN"
msgstr "Konfirmasi PIN"

#. Translators: Hint for disk encryption
#: data/resources/ui/pages/encrypt.blp
msgid ""
"Memorize this PIN well. Without it you will not be able to access your files."
msgstr ""
"Ingat PIN ini dengan baik. Tanpa PIN ini Anda tidak akan dapat mengakses "
"file Anda."

#. Translators: Title of installation failure page.
#: data/resources/ui/pages/failed.blp
msgid "Error During Installation"
msgstr "Kesalahan Selama Instalasi"

#. Translators: Installation failure description. Brackets will be replaced by the distribution name.
#: data/resources/ui/pages/failed.blp
msgid ""
"Details on the error that occured can be found in the installation logs. "
"Please report this error to {}."
msgstr ""
"Detail kesalahan yang terjadi dapat ditemukan di log instalasi. Harap "
"laporkan kesalahan ini ke {}."

#. Translators: Shown if installation fails.
#: data/resources/ui/pages/failed.blp
msgid "Search for Help on the Internet"
msgstr "Cari Bantuan di Internet"

#: data/resources/ui/pages/filter.blp
msgid "Filter"
msgstr "Filter"

#. Translators: Empty result placeholder title
#: data/resources/ui/pages/filter.blp
msgid "No Results"
msgstr "Tidak Ada Hasil"

#. Translators: Empty result placeholder, meant as a suggestion
#: data/resources/ui/pages/filter.blp
msgid "Try a different search"
msgstr "Coba Pencarian Berbeda"

#: data/resources/ui/pages/internet.blp
msgid "No connection detected"
msgstr "Tidak Ada Koneksi Terdeteksi"

#. Translators: On button for opening wifi settings.
#: data/resources/ui/pages/internet.blp
msgid "_Open Settings"
msgstr "Buka Pengaturan"

#: data/resources/ui/pages/internet.blp
msgid "Connection detected"
msgstr "Koneksi Terdeteksi"

#. selectable: false;
#. Translators: Followed by a language name.
#. Translators: Page title
#: data/resources/ui/pages/keyboard_layout.blp src/ui/page_wrapper.py
msgid "Keyboard Language"
msgstr "Bahasa Keyboard"

#. Translators: Used as placeholder in a entry field to try out a keyboard layout
#: data/resources/ui/pages/keyboard_overview.blp
msgid "Test the Keyboard Layout Here"
msgstr "Uji Tata Letak Keyboard di Sini"

#. Translators: Presented next to the current Timezone.
#. Translators: Description of selected timezone.
#: data/resources/ui/pages/region.blp data/resources/ui/pages/summary.blp
msgid "Timezone"
msgstr "Zona Waktu"

#. Translators: Presented next to the current Formats.
#. Translators: Description of selected format.
#: data/resources/ui/pages/region.blp data/resources/ui/pages/summary.blp
msgid "Formats"
msgstr "Format"

#. Translators: Description of what is covered by formats.
#: data/resources/ui/pages/region.blp
msgid ""
"Formats define how dates, times and numbers are presented. They also impact "
"office program defaults."
msgstr ""
"Format menentukan cara tanggal, waktu, dan angka disajikan. Format juga "
"memengaruhi pengaturan default program perkantoran."

#. Translators: Description of selected language.
#: data/resources/ui/pages/summary.blp
msgid "Language"
msgstr "Bahasa"

#. Translators: Description of selected keyboard layout.
#. Translators: Page title
#: data/resources/ui/pages/summary.blp src/ui/page_wrapper.py
msgid "Keyboard Layout"
msgstr "Tata Letak Keyboard"

#. Translators: Description of selected keyboard layout.
#: data/resources/ui/pages/summary.blp
msgid "Desktop"
msgstr "Desktop"

#. Translators: Description of defined user account name and autologin status.
#. Translators: Page title
#: data/resources/ui/pages/summary.blp src/ui/page_wrapper.py
msgid "User Account"
msgstr "Akun Pengguna"

#. Translators: Gets shown when autologin is enabled.
#: data/resources/ui/pages/summary.blp
msgid "(Automatic Login)"
msgstr "(Login Otomatis)"

#. Translators: Description of selected additional software.
#. Translators: Page title
#: data/resources/ui/pages/summary.blp src/ui/page_wrapper.py
msgid "Additional Software"
msgstr "Perangkat Lunak Tambahan"

#. Translators: Description of selected additional features.
#. Translators: Page title
#: data/resources/ui/pages/summary.blp src/ui/page_wrapper.py
msgid "Additional Features"
msgstr "Fitur Tambahan"

#. Translators: Used with entry field for User's name
#: data/resources/ui/pages/user.blp
msgid "_Name"
msgstr "Nama"

#. Translators: Used with entry field for linux username
#: data/resources/ui/pages/user.blp
msgid "_Username"
msgstr "Nama Pengguna"

#. Translators: Used with option to enable automatic login of user upon booting
#: data/resources/ui/pages/user.blp
msgid "Automatic Login"
msgstr "Login Otomatis"

#. Translators: User password entry field
#: data/resources/ui/pages/user.blp
msgid "_Password"
msgstr "Kata Sandi"

#. Translators: Used password confirmation entry field
#: data/resources/ui/pages/user.blp
msgid "C_onfirm Password"
msgstr "Konfirmasi Kata Sandi"

#. Translators: Default welcome text. Squiggly brackets are replaced by distribution name.
#: data/resources/ui/pages/welcome.blp
msgid ""
"This application will guide you through the installation of {} onto your "
"system."
msgstr "Aplikasi ini akan memandu Anda melalui instalasi {} ke sistem Anda."

#. Translators: Label to use whole disk rather than a single partition.
#: data/resources/ui/row/device_choice_row.blp
msgid "Use Whole Disk"
msgstr "Gunakan Seluruh Disk"

#. Translators: Label for disk with mounted filesystem
#: data/resources/ui/row/device_mounted_row.blp
msgid "Has filesystem(s) in use"
msgstr "Memiliki sistem file yang sedang digunakan"

#. Translators: Button to unmount filesystems
#: data/resources/ui/row/device_mounted_row.blp
msgid "Unmount"
msgstr "Lepas Pasang"

# Translators: Label for disk with root filesystem mounted
#: data/resources/ui/row/device_rootfs_disk_row.blp
msgid "System disk in use"
msgstr "Disk sistem sedang digunakan"

#. Translators: Shown for partitions that are not big enough to be installed on.
#. * "{}" is replaced by a disk size value, e.g. "21.3 GB".
#: data/resources/ui/row/device_too_small_row.blp
msgid "Not enough space for installation ({} required)"
msgstr "Ruang tidak cukup untuk instalasi ({} diperlukan)"

#. Translators: Shown if a disk is currently not compatible with the way a system was booted.
#: data/resources/ui/row/no_efi_partition_row.blp
msgid "Selecting a partition is not possible."
msgstr "Memilih partisi tidak mungkin."

#. Translators: Followed by a list of requirements
#: data/resources/ui/row/no_efi_partition_row.blp
msgid "The disk requires:"
msgstr "Disk memerlukan:"

#. Translators: Bullet point listing.
#: data/resources/ui/row/no_efi_partition_row.blp
msgid ""
"  • GPT partitioning\n"
"  • EFI partition"
msgstr ""
"  • Partisi GPT\n"
"  • Partisi EFI"

#. Translators: Bullet point listing.
#: data/resources/ui/row/no_efi_partition_row.blp
msgid "  • BIOS boot partition"
msgstr "  • Partisi boot BIOS"

#. Translators: Notification text
#. Translators: Page title
#: src/core/installation_scripting.py src/ui/page_wrapper.py
msgid "Installation Failed"
msgstr "Instalasi Gagal"

#. Translators: Notification text
#: src/core/installation_scripting.py
msgid "Finished Installation"
msgstr "Instalasi Selesai"

#. Translators: Fallback name for partitions that don't have a name
#: src/provider/disk_provider.py
msgid "Unnamed Partition"
msgstr "Partisi Tanpa Nama"

#. Translators: Squiggly brackets are replaced with partition name
#: src/provider/disk_provider.py
#, python-brace-format
msgid "{} (Partition)"
msgstr "{} (Partisi)"

#. Translators: Fallback name for partitions that don't have a name
#: src/provider/disk_provider.py
msgid "Unnamed Disk"
msgstr "Disk Tanpa Nama"

#. Translators: On button.
#: src/ui/buttons.py
msgid "_Continue"
msgstr "Lanjutkan"

#. Translators: On button.
#: src/ui/buttons.py
msgid "_Confirm"
msgstr "Konfirmasi"

#. Translators: Hover information on toggle button that shows terminal output.
#: src/ui/buttons.py
msgid "Show Terminal Output"
msgstr "Tampilkan Output Terminal"

#. Translators: Dialog title
#: src/ui/confirm_quit_dialog.py
msgid "Installation Running"
msgstr "Instalasi Berjalan"

#: src/ui/confirm_quit_dialog.py
msgid ""
"Stopping a running installation will leave the disk in an undefined state "
"that might potentially be harmful"
msgstr ""
"Menghentikan instalasi yang berjalan akan meninggalkan disk dalam keadaan "
"tidak terdefinisi yang berpotensi berbahaya"

#. Translators: Underscore can not be the same as for 'Stop Installation'.
#: src/ui/confirm_quit_dialog.py
msgid "_Continue Installation"
msgstr "Lanjutkan Instalasi"

#. Translators: Underscore can not be the same as for 'Continue Installation'.
#: src/ui/confirm_quit_dialog.py
msgid "_Stop Installation"
msgstr "Hentikan Instalasi"

#. Translators: Page title
#: src/ui/page_wrapper.py
msgid "Confirmation"
msgstr "Konfirmasi"

#. Translators: Page title
#: src/ui/page_wrapper.py
msgid "Desktop Selection"
msgstr "Pemilihan Desktop"

#. Translators: Page title
#: src/ui/page_wrapper.py
msgid "Disk Selection"
msgstr "Pemilihan Disk"

#. Translators: Page title
#: src/ui/page_wrapper.py
msgid "Installation Complete"
msgstr "Instalasi Lengkap"

#. Translators: Page title
#: src/ui/page_wrapper.py
msgid "Disk Encryption"
msgstr "Enkripsi Disk"

#. Translators: Page title
#: src/ui/page_wrapper.py
msgid "Select Region"
msgstr "Pilih Wilayah"

#. Translators: Page title
#: src/ui/page_wrapper.py
msgid "Installing"
msgstr "Menginstal"

#. Translators: Page title
#: src/ui/page_wrapper.py
msgid "Internet Connection Check"
msgstr "Pemeriksaan Koneksi Internet"

#. Translators: Page title
#: src/ui/page_wrapper.py
msgid "Keyboard Layout Selection"
msgstr "Pemilihan Tata Letak Keyboard"

#. Translators: Page title
#: src/ui/page_wrapper.py
msgid "Adapt to Location"
msgstr "Sesuaikan dengan Lokasi"

#. Translators: Page title
#: src/ui/page_wrapper.py
msgid "Restarting"
msgstr "Memulai Ulang"

#. Translators: Page title
#: src/ui/page_wrapper.py
msgid "Summary"
msgstr "Ringkasan"

#. Translators: Page title
#: src/ui/page_wrapper.py
msgid "Select Location"
msgstr "Pilih Lokasi"

#. Translators: Page title
#: src/ui/page_wrapper.py
msgid "Welcome"
msgstr "Selamat Datang"

#. Translators: Shown when list of selected software is empty.
#: src/ui/pages/summary.py
msgid "None"
msgstr "Tidak Ada"

#. Translators: Description of selected disk.
#: src/ui/row/device_rows.py
msgid "Disk"
msgstr "Disk"
