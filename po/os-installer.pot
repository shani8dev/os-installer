#: data/org.shani.OsInstaller.metainfo.xml
msgid ""
"The installer used by ShaniOS live images. It is a fork of GNOME's os-"
"installer and provides the Adwaita interface ShaniOS ships: language, "
"keyboard, disk and encryption selection, user setup, then the distro's own "
"prepare/install/configure scripts."
msgstr ""

#: data/org.shani.OsInstaller.metainfo.xml
msgid ""
"ShaniOS specific behaviour comes from /etc/os-installer and its config.yaml, "
"not from this package."
msgstr ""

#: data/org.shani.OsInstaller.metainfo.xml
msgid "First release of the ShaniOS fork:"
msgstr ""

#: data/org.shani.OsInstaller.metainfo.xml
msgid "Runs install scripts through bash instead of exec'ing them directly"
msgstr ""

